---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard">

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />

<style>
  .shell {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .card {
    margin-bottom: 20px;
    transition: border-color 0.3s;
  }

  .card:hover { border-color: rgba(255,255,255,0.12); }

  .drop-zone {
    border: 1.5px dashed rgba(0,229,255,0.2);
    border-radius: 10px;
    padding: 32px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25s ease;
    background: rgba(0,229,255,0.03);
    position: relative;
  }

  .drop-zone:hover, .drop-zone.dragover {
    border-color: var(--accent);
    background: var(--accent-dim);
    box-shadow: 0 0 30px var(--accent-glow);
  }

  .drop-zone input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .drop-icon {
    width: 44px;
    height: 44px;
    margin: 0 auto 12px;
    background: var(--accent-dim);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .drop-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
  .drop-sub { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }

  .file-selected-info {
    display: none;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 10px 14px;
    background: var(--green-dim);
    border: 1px solid rgba(0,255,136,0.18);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
  }

  .file-selected-info.visible { display: flex; }

  .upload-btn {
    width: 100%;
    margin-top: 16px;
    padding: 14px;
    background: var(--green-dim);
    color: var(--green);
    border: 1px solid rgba(0,255,136,0.25);
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .upload-btn:hover:not(:disabled) {
    background: rgba(0,255,136,0.2);
    border-color: rgba(0,255,136,0.45);
    box-shadow: 0 0 28px rgba(0,255,136,0.15);
  }

  .upload-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .status-bar {
    display: none;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    margin-top: 12px;
    align-items: center;
    gap: 10px;
  }

  .status-bar.visible { display: flex; }
  .status-bar.loading { background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(0,229,255,0.2); }
  .status-bar.success { background: var(--green-dim); color: var(--green); border: 1px solid rgba(0,255,136,0.2); }
  .status-bar.error { background: var(--danger-dim); color: var(--danger); border: 1px solid rgba(255,68,102,0.2); }

  .question-input {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 15px;
    outline: none;
    transition: all 0.2s;
    resize: none;
  }

  .question-input::placeholder { color: var(--text-muted); }

  .question-input:focus {
    border-color: rgba(0,229,255,0.35);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .ask-btn {
    width: 100%;
    margin-top: 12px;
    padding: 14px;
    background: linear-gradient(135deg, rgba(0,229,255,0.15), rgba(0,229,255,0.06));
    color: var(--accent);
    border: 1px solid rgba(0,229,255,0.25);
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ask-btn:hover:not(:disabled) {
    background: var(--accent-dim);
    border-color: rgba(0,229,255,0.5);
    box-shadow: 0 0 30px var(--accent-glow);
  }

  .ask-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .response-area { display: none; margin-top: 24px; }
  .response-area.visible { display: block; }

  .response-header {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .response-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .response-body {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--text-dim);
    white-space: pre-wrap;
    animation: fadeSlide 0.3s ease;
  }

  .spinner-sm {
    width: 14px; height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    display: none;
    animation: spin 0.7s linear infinite;
  }

  .loading .spinner-sm { display: block; }

  .thinking {
    display: none;
  }

  .thinking.visible {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 16px 20px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-top: 24px;
  }

  .thinking span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: bounce 1s ease infinite;
  }

  .thinking span:nth-child(2) { animation-delay: 0.15s; }
  .thinking span:nth-child(3) { animation-delay: 0.3s; }
</style>

<div class="shell">

  <div class="page-header">
    <div>
      <div class="logo-eyebrow cyan">Agente inteligente</div>
      <h1 class="logo-title">RAG <span class="cyan">PDF</span></h1>
    </div>
    <button id="logoutBtn" class="logout-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      Cerrar sesión
    </button>
  </div>

  <div class="card">
    <div class="card-accent-line green"></div>
    <div class="card-label">01 — Cargar documento</div>

    <div class="drop-zone" id="dropZone">
      <input type="file" id="pdf" accept=".pdf" />
      <div class="drop-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
        </svg>
      </div>
      <div class="drop-title">Arrastra tu PDF aquí</div>
      <div class="drop-sub">o haz clic para seleccionar</div>
    </div>

    <div class="file-selected-info" id="fileInfo">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <span id="fileName"></span>
    </div>

    <button id="uploadBtn" class="upload-btn" disabled>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
      </svg>
      <span id="uploadBtnText">Subir PDF</span>
      <div class="spinner-sm"></div>
    </button>

    <div class="status-bar" id="uploadStatus">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span id="uploadStatusText"></span>
    </div>
  </div>

  <div class="card">
    <div class="card-accent-line cyan"></div>
    <div class="card-label">02 — Hacer una pregunta</div>

    <textarea id="question" class="question-input" placeholder="Ej: ¿Cuál es el argumento principal del documento?" rows="3"></textarea>

    <button id="askBtn" class="ask-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
      <span id="askBtnText">Preguntar</span>
      <div class="spinner-sm"></div>
    </button>

    <div class="thinking" id="thinking">
      <span></span><span></span><span></span>
    </div>

    <div class="response-area" id="responseArea">
      <div class="response-header">
        <div class="response-dot"></div>
        Respuesta
      </div>
      <div class="response-body" id="response"></div>
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    localStorage.removeItem('token');
    sessionStorage.clear();
    window.location.href = '/login';
  });

  const pdfInput      = document.getElementById('pdf');
  const dropZone      = document.getElementById('dropZone');
  const fileInfo      = document.getElementById('fileInfo');
  const fileName      = document.getElementById('fileName');
  const uploadBtn     = document.getElementById('uploadBtn');
  const uploadBtnText = document.getElementById('uploadBtnText');
  const uploadStatus  = document.getElementById('uploadStatus');
  const uploadStatusText = document.getElementById('uploadStatusText');

  const questionInput = document.getElementById('question');
  const askBtn        = document.getElementById('askBtn');
  const askBtnText    = document.getElementById('askBtnText');
  const thinking      = document.getElementById('thinking');
  const responseArea  = document.getElementById('responseArea');
  const responseDiv   = document.getElementById('response');

  pdfInput.addEventListener('change', () => {
    const file = pdfInput.files?.[0];
    if (!file) return;
    fileName.textContent = file.name;
    fileInfo.classList.add('visible');
    uploadBtn.disabled = false;
  });

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const file = e.dataTransfer.files?.[0];
    if (file) {
      const dt = new DataTransfer();
      dt.items.add(file);
      pdfInput.files = dt.files;
      fileName.textContent = file.name;
      fileInfo.classList.add('visible');
      uploadBtn.disabled = false;
    }
  });

  uploadBtn.addEventListener('click', async () => {
    const file = pdfInput.files?.[0];
    if (!file) return;

    uploadBtn.disabled = true;
    uploadBtn.classList.add('loading');
    uploadBtnText.textContent = 'Subiendo...';
    uploadStatus.classList.remove('visible');

    try {
      const formData = new FormData();
      formData.append("file", file);
      const token = localStorage.getItem("token");
      const res = await fetch("http://localhost:8000/upload", {
        method: "POST",
        headers: { "Authorization": `Bearer ${token}` },
        body: formData
      });
      const data = await res.json();
      uploadStatus.className = 'status-bar visible success';
      uploadStatusText.textContent = data.message || 'PDF cargado correctamente.';
    } catch {
      uploadStatus.className = 'status-bar visible error';
      uploadStatusText.textContent = 'Error al subir el archivo.';
    } finally {
      uploadBtn.disabled = false;
      uploadBtn.classList.remove('loading');
      uploadBtnText.textContent = 'Subir PDF';
    }
  });

  askBtn.addEventListener('click', async () => {
    const question = questionInput.value.trim();
    if (!question) return;

    askBtn.disabled = true;
    askBtn.classList.add('loading');
    askBtnText.textContent = 'Procesando...';
    thinking.classList.add('visible');
    responseArea.classList.remove('visible');

    try {
      const token = localStorage.getItem("token");
      const res = await fetch("http://localhost:8000/ask", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${token}`
        },
        body: JSON.stringify({ question })
      });
      const data = await res.json();
      responseDiv.textContent = data.answer;
      responseArea.classList.add('visible');
    } catch {
      responseDiv.textContent = 'Ocurrió un error al obtener la respuesta.';
      responseArea.classList.add('visible');
    } finally {
      askBtn.disabled = false;
      askBtn.classList.remove('loading');
      askBtnText.textContent = 'Preguntar';
      thinking.classList.remove('visible');
    }
  });

  questionInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      askBtn.click();
    }
  });
});
</script>

</Layout>
